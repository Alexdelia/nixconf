(defwindow power_menu
	:monitor 0
	:geometry (geometry
		:x "0px"
		:y "0px"
		:width "80%"
		:height "50%"
		:anchor "center"
	)
    :stacking "fg"
	:focusable true

	(box
		:orientation "horizontal"
		:halign "center"
		:valign "center"
		:space-evenly false

		(power_menu_btn :text "" :onclick "poweroff")
		(power_menu_btn :text "" :onclick "reboot")
		(power_menu_btn :text "" :onclick "systemctl hibernate")
	)
)

(defwidget power_menu_btn [text onclick]
	(button
		:class "power-menu-btn"
		:onclick onclick
		:timeout "30s"

		:width 240
		:height 240

		(label
			;; :justify ""
			:xalign 0.25

			:text text
		)
	)
)

