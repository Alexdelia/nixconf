-use nix::unistd::{Gid, Uid, User};
-use std::{ffi::CString, process::exit};
+use nix::errno::Errno;
+use nix::unistd::{getgrouplist, setgid, setgroups, setuid, Gid, Uid, User};
+use std::{ffi::CString, io, process::exit};
+
+#[derive(Clone)]
+pub struct UserCredentials {
+    uid: Uid,
+    gid: Gid,
+    supplementary_groups: Vec<Gid>,
+}
+
+impl UserCredentials {
+    pub fn resolve_before_fork(user: &User) -> Self {
+        let username = CString::new(user.name.as_str())
+            .expect("Failed to convert username to CString");
+
+        let supplementary_groups = getgrouplist(&username, user.gid).unwrap_or_else(|e| {
+            log::error!("Failed to resolve supplementary groups: {:#?}", e);
+            vec![user.gid]
+        });
+
+        Self { uid: user.uid, gid: user.gid, supplementary_groups }
+    }
+
+    pub fn apply_with_syscalls_only(&self) -> io::Result<()> {
+        setgroups(&self.supplementary_groups).map_err(errno_to_io)?;
+        setgid(self.gid).map_err(errno_to_io)?;
+        setuid(self.uid).map_err(errno_to_io)
+    }
+}
+
+fn errno_to_io(errno: Errno) -> io::Error {
+    io::Error::from_raw_os_error(errno as i32)
+}
 
