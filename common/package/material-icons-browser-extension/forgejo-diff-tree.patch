+import { Manifest } from 'material-icon-theme';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { replaceIconInRow } from '../lib/replace-icon';
+import forgejo from './forgejo';
+
+vi.mock('webextension-polyfill', () => ({
+  default: {
+    runtime: {
+      getURL: (name: string) => `chrome-extension://test-id/${name}`,
+    },
+  },
+}));
+
+vi.mock('../icon-list.json', () => ({
+  default: {
+    file: 'file.svg',
+    folder: 'folder.svg',
+    'folder-open': 'folder-open.svg',
+    'folder-src': 'folder-src.svg',
+    'folder-src-open': 'folder-src-open.svg',
+    typescript: 'typescript.svg',
+  },
+}));
+
+const manifest: Manifest = {
+  fileNames: {},
+  fileExtensions: { ts: 'typescript' },
+  languageIds: {},
+  folderNames: { src: 'folder-src' },
+  folderNamesExpanded: { src: 'folder-src-open' },
+};
+
+const provider = forgejo();
+
+const fileItem = `
+  <div class="diff-file-tree-items">
+    <a class="item-file" title="main.ts" href="#diff-0000">
+      <svg class="svg octicon-file"></svg>
+      <span class="gt-ellipsis tw-flex-1">main.ts</span>
+      <svg class="svg octicon-diff-modified text yellow"></svg>
+    </a>
+  </div>`;
+
+const directoryItem = `
+  <div class="diff-file-tree-items">
+    <div class="item-directory" title="src">
+      <svg class="svg octicon-chevron-down"></svg>
+      <svg class="svg text primary octicon-file-directory-fill"></svg>
+      <span class="gt-ellipsis">src</span>
+    </div>
+  </div>`;
+
+const firstRow = () =>
+  document.querySelector(provider.selectors.row) as HTMLElement;
+
+const replacedIcon = (row: HTMLElement) =>
+  row.querySelector('[data-material-icons-extension]');
+
+describe('Forgejo provider - diff file tree', () => {
+  beforeEach(() => {
+    document.body.innerHTML = '';
+  });
+
+  it('should replace the icon of a file item', () => {
+    document.body.innerHTML = fileItem;
+    const row = firstRow();
+
+    replaceIconInRow(row, provider, manifest);
+
+    expect(
+      replacedIcon(row)?.getAttribute('data-material-icons-extension-iconname')
+    ).toBe('typescript.svg');
+    expect(
+      replacedIcon(row)?.getAttribute('data-material-icons-extension-filename')
+    ).toBe('main.ts');
+  });
+
+  it('should leave the diff type icon untouched', () => {
+    document.body.innerHTML = fileItem;
+    const row = firstRow();
+
+    replaceIconInRow(row, provider, manifest);
+
+    expect(row.querySelector('svg.octicon-diff-modified')).not.toBeNull();
+  });
+
+  it('should replace the icon of a directory item with a folder icon', () => {
+    document.body.innerHTML = directoryItem;
+    const row = firstRow();
+
+    replaceIconInRow(row, provider, manifest);
+
+    expect(
+      replacedIcon(row)?.getAttribute('data-material-icons-extension-iconname')
+    ).toBe('folder-src.svg');
+  });
+
+  it('should leave the collapse chevron untouched', () => {
+    document.body.innerHTML = directoryItem;
+    const row = firstRow();
+
+    replaceIconInRow(row, provider, manifest);
+
+    expect(row.querySelector('svg.octicon-chevron-down')).not.toBeNull();
+  });
+});
