 #### ANILIST ANIME FUNCTIONS ####
+load_voice() {
+    sub_or_dub=$($sed -nE "s@^$media_id\t(sub|dub)\$@\1@p" "$voice_file" 2>/dev/null)
+    [ -z "$sub_or_dub" ] && sub_or_dub="sub"
+}
+
+save_voice() {
+    [ -f "$voice_file" ] && $sed -i "/^$media_id\t/d" "$voice_file"
+    printf "%s\t%s\n" "$media_id" "$sub_or_dub" >>"$voice_file"
+}
+
+search_anime_menu() {
+    anime_row=$(ANILIST_TOKEN="$access_token" "$anime_menu" search)
+    [ -z "$anime_row" ] && exit 1
+    IFS="$(printf '\t')" read -r media_id _ title progress episodes_total _ start_year _ episodes_aired <<EOF
+$anime_row
+EOF
+    if [ "$episodes_aired" -lt 1 ]; then
+        send_notification "$title" "" "" "not aired yet"
+        exit 1
+    fi
+
+    load_voice
+    [ "$sub_or_dub" = "dub" ] && voice_index=1 || voice_index=0
+    case "$(printf "original\nenglish\n" | "$anime_menu" pick "voice" "$voice_index")" in
+        original) sub_or_dub="sub" ;;
+        english) sub_or_dub="dub" ;;
+        *) exit 1 ;;
+    esac
+
+    [ "$progress" -lt "$episodes_aired" ] && episode_index=$progress || episode_index=$((episodes_aired - 1))
+    episode=$(seq "$episodes_aired" | "$anime_menu" pick "episode" "$episode_index")
+    [ -z "$episode" ] && exit 1
+
+    save_voice
+    progress=$((episode - 1))
+    [ "$episodes_total" = "?" ] && episodes_total=9999
+}
