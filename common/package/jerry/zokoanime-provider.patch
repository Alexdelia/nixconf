+zokoanime_deobfuscate() (
+    bytes="$(printf "%s\n" "$1" | base64 -d | od -v -An -tu1)"
+    set -- 111 116 97 107 117 45 101 109 98 101 100 45 118 49
+    output=""
+    for byte in $bytes; do
+        char=$((byte ^ $1))
+        output="${output}\\0$((char / 64))$(((char / 8) % 8))$((char % 8))"
+        set -- "$@" "$1"
+        shift
+    done
+    printf "%b" "$output"
+)
