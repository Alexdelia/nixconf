diff --git a/src/providers/index.test.ts b/src/providers/index.test.ts
new file mode 100644
index 0000000..571be58
--- /dev/null
+++ b/src/providers/index.test.ts
@@ -0,0 +1,50 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import Browser from 'webextension-polyfill';
+import { addGitProvider, getGitProvider, removeGitProvider } from './index';
+
+vi.mock('webextension-polyfill', () => ({
+  default: {
+    storage: {
+      sync: {
+        get: vi.fn(),
+        set: vi.fn(),
+      },
+    },
+  },
+}));
+
+const mockGet = Browser.storage.sync.get as ReturnType<typeof vi.fn>;
+
+describe('getGitProvider', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mockGet.mockResolvedValue({});
+  });
+
+  it('resolves a built in provider by domain', async () => {
+    const provider = await getGitProvider('https://github.com/foo/bar');
+
+    expect(provider?.name).toBe('github');
+  });
+
+  it('resolves a custom provider hosted on a port', async () => {
+    addGitProvider('localhost:8080', 'forgejo');
+
+    const provider = await getGitProvider('http://localhost:8080/foo/bar');
+
+    expect(provider?.name).toBe('localhost:8080');
+    expect(provider?.selectors.row).toBe(
+      '#repo-files-table .entry, #repo-files-table .repo-file-item'
+    );
+
+    removeGitProvider('localhost:8080');
+  });
+
+  it('does not resolve a custom provider on a different port', async () => {
+    addGitProvider('127.0.0.1:8080', 'forgejo');
+
+    expect(await getGitProvider('http://127.0.0.1:9000/foo/bar')).toBeNull();
+
+    removeGitProvider('127.0.0.1:8080');
+  });
+});
